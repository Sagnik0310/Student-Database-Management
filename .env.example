# ==============================================================================
# Student Database Management System 2.0 — Environment Configuration Template
# Copy to .env (or config.env) for local development. Never commit real secrets.
# ==============================================================================

# 1. Runtime Mode ("development" or "production")
APP_ENV=development
FLASK_DEBUG=false
PORT=10000

# 2. MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=student_db

# 3. Cryptographic Session & Cookie Security
# In production, SECRET_KEY must be >= 32 characters and not a placeholder.
SECRET_KEY=replace-with-a-64-char-random-cryptographic-secret
# Optional previous key for zero-downtime key rotation:
SECRET_KEY_PREVIOUS=
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=true
COOKIE_SAMESITE=None
CORS_ORIGINS=http://localhost:3000,https://student-database-management-l3pl.onrender.com

# 4. Initial Bootstrap Accounts (change immediately in production)
ALLOW_DEFAULT_DEMO_USERS=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
FACULTY_USERNAME=faculty_cse
FACULTY_PASSWORD=replace-with-strong-faculty-password
STUDENT_USERNAME=student_demo
STUDENT_PASSWORD=replace-with-strong-student-password
STUDENT_LINKED_REG_NO=REG2026001

# 5. Phase 4: Optional AI Analytics Assistant (Backend-Only Credentials)
# Provider options: deterministic (default, no API key needed), gemini, openai
AI_ASSISTANT_PROVIDER=deterministic
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_MODEL=gemini-2.5-flash
AI_ASSISTANT_TIMEOUT_SEC=8
AI_ALLOW_EXTERNAL_AGGREGATES=true

# 6. Phase 4: Reporting & Export Safety Limits
MAX_EXPORT_ROWS=2000
MAX_DATE_RANGE_DAYS=366

# 7. Shared Rate Limiting & Reverse Proxy (Flask-Limiter / limits / Werkzeug ProxyFix)
# Local dev/tests default to memory:// when unset.
# Production requires a shared backend (e.g. redis://, rediss://, or mongodb+srv://)
# so Gunicorn workers share a unified rate-limit budget.
RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_FAIL_CLOSED=true
RATELIMIT_SOCKET_TIMEOUT=1.0
TRUSTED_PROXY_HOPS=1
